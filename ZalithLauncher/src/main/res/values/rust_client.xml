<!-- Strings added by Rust Client. Kept out of strings.xml so upstream merges stay clean. -->
<resources>
    <!-- The activity the engine module starts as the game (EngineHost.gameIntent) -->
    <string name="rust_engine_game_activity" translatable="false">com.movtery.zalithlauncher.game.rust.RustGameActivity</string>

    <!-- Edition selector on the home screen -->
    <string name="game_edition_title">Game Edition</string>
    <string name="game_edition_java">Java Edition</string>
    <string name="game_edition_rust">Rust Edition</string>
    <string name="game_edition_java_summary">Minecraft: Java Edition. Any version, mod loaders and Java mods, run by a Java runtime.</string>
    <!-- %1$s is the Minecraft version, %2$s the engine's name -->
    <string name="game_edition_rust_summary">Minecraft %1$s on the native %2$s engine: no Java runtime, Vulkan rendering. Worlds, resource packs and shader packs are kept in its own folder, apart from the Java Edition. Java mods do not work in it. Played with your control layout.</string>
    <!-- %1$s is the Minecraft version -->
    <string name="rust_edition_version">Minecraft %1$s · Native</string>
    <string name="rust_edition_problem_not_included">This build does not contain the Rust Edition engine. It is only part of the ARM64 (arm64-v8a) and universal APKs.</string>
    <string name="rust_edition_problem_no_vulkan">The Rust Edition needs Vulkan 1.3, which this device does not provide. Java Edition is not affected.</string>
    <string name="rust_edition_touch_screen">Touch the screen directly (no mouse pointer)</string>
    <string name="rust_edition_folder_game">Game folder</string>
    <string name="rust_edition_folder_worlds">Worlds</string>
    <string name="rust_edition_folder_resource_packs">Resource packs</string>
    <string name="rust_edition_folder_shader_packs">Shader packs</string>
    <string name="rust_edition_folder_data_packs">Data packs</string>
    <string name="rust_edition_folder_screenshots">Screenshots</string>

    <!-- Download screen of the Rust Edition (RustSetupActivity) -->
    <string name="rust_setup_title">Rust Edition game resources</string>
    <!-- %1$s is the Minecraft version -->
    <string name="rust_setup_summary">The Rust Edition needs the files of Minecraft %1$s. They are downloaded from Mojang and prepared on this device once; this takes a while and several hundred megabytes. Keep this screen open until it is done.</string>
    <string name="rust_setup_download">Download</string>
    <string name="rust_setup_retry">Try again</string>
    <string name="rust_setup_stop">Stop</string>
    <string name="rust_setup_close">Close</string>
    <string name="rust_setup_done">The game resources are ready.</string>
    <!-- %1$s is the reason, in the engine's words -->
    <string name="rust_setup_failed">It did not work: %1$s</string>
    <string name="rust_setup_stage_starting">Starting</string>
    <string name="rust_setup_stage_checking">Checking the game files</string>
    <string name="rust_setup_stage_download">Downloading the game files</string>
    <string name="rust_setup_stage_java">Downloading the Java runtime used for the preparation</string>
    <string name="rust_setup_stage_unpacking">Unpacking the Java runtime</string>
    <string name="rust_setup_stage_preparing">Preparing the game resources</string>
    <!-- %1$s is "12 MB / 340 MB", %2$s is "120/3400" (files) -->
    <string name="rust_setup_files">%1$s · files %2$s</string>
</resources>
