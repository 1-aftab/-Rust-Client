+/// Rust Client: `StarlingActivity.nativeExternalTouch`. A finger on the host launcher's window
+/// over the game's, which the game takes as a touch on its own: `phase` 0 lands, 1 moves,
+/// 2 lifts, 3 is taken away; (`x`, `y`) in window pixels.
+#[unsafe(no_mangle)]
+extern "system" fn Java_io_github_juanluci_starling_StarlingActivity_nativeExternalTouch(
+    _env: *mut std::ffi::c_void,
+    _class: *mut std::ffi::c_void,
+    finger: i32,
+    phase: i32,
+    x: f32,
+    y: f32,
+) {
+    use horizon_client::android::MouseEvent;
+    if !(0..=3).contains(&phase) {
+        return;
+    }
+    horizon_client::android::push_external_mouse(MouseEvent::Finger(
+        finger as u32 as u64,
+        phase as u8,
+        f64::from(x),
+        f64::from(y),
+    ));
+}
+
 /// Rust Client: `StarlingActivity.nativeExternalKeyboard`. The keyboard button of the host
