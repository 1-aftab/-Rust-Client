+/// Rust Client, X-Ray: 0 when off; else bit 31, the block groups to draw a bit each (the
+/// client's `rc_qol::XRAY_GROUPS`) and bit 30 for all of it fully lit. A section is meshed as
+/// if every other block were air. The game sets it and meshes every section again.
+pub static XRAY: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+/// The X-Ray group of the block `name` (without its namespace) as its bit, 0 for none.
+fn xray_group(name: &str) -> u32 {
+    let group = match name {
+        "nether_gold_ore" => 9,
+        "nether_quartz_ore" => 8,
+        "ancient_debris" => 10,
+        "barrel" => 12,
+        "lava" => 15,
+        "water" => 16,
+        "budding_amethyst" | "amethyst_cluster" => 17,
+        "end_portal_frame" | "end_portal" | "nether_portal" => 18,
+        "vault" | "trial_spawner" => 14,
+        _ if name.ends_with("coal_ore") => 0,
+        _ if name.ends_with("iron_ore") => 1,
+        _ if name.ends_with("copper_ore") => 2,
+        _ if name.ends_with("gold_ore") => 3,
+        _ if name.ends_with("redstone_ore") => 4,
+        _ if name.ends_with("lapis_ore") => 5,
+        _ if name.ends_with("diamond_ore") => 6,
+        _ if name.ends_with("emerald_ore") => 7,
+        _ if name.ends_with("chest") => 11,
+        _ if name.ends_with("shulker_box") => 13,
+        _ if name.ends_with("spawner") => 14,
+        _ => return 0,
+    };
+    1 << group
+}
