diff --git a/crates/horizon-client/src/rc_qol.rs b/crates/horizon-client/src/rc_qol.rs
new file mode 100644
index 0000000..bf331b1
--- /dev/null
+++ b/crates/horizon-client/src/rc_qol.rs
@@ -0,0 +1,69 @@
+//! Rust Client: the quality-of-life switches. The launcher's "QOL" page writes them to
+//! `rust-client-qol.txt` in the game folder (`key=value` lines); the game reads the file
+//! again twice a second, so a switch acts at once. Everything is off without the file.
+use std::sync::RwLock;
+use std::sync::atomic::{AtomicU32, Ordering};
+
+/// The file, in the game folder (the working directory).
+pub const FILE: &str = "rust-client-qol.txt";
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Qol {
+    /// Always sprint while moving forward.
+    pub sprint: bool,
+    /// Only ores, containers, spawners and lava are drawn, fully lit.
+    pub xray: bool,
+}
+
+pub const OFF: Qol = Qol {
+    sprint: false,
+    xray: false,
+};
+
+impl Qol {
+    pub fn parse(text: &str) -> Self {
+        let mut q = OFF;
+        for line in text.lines() {
+            let Some((key, value)) = line.split_once('=') else {
+                continue;
+            };
+            let value = value.trim();
+            let on = value == "true" || value == "1";
+            match key.trim() {
+                "sprint" => q.sprint = on,
+                "xray" => q.xray = on,
+                _ => {}
+            }
+        }
+        q
+    }
+}
+
+static NOW: RwLock<Qol> = RwLock::new(OFF);
+static CALLS: AtomicU32 = AtomicU32::new(0);
+
+/// The switches as they are now.
+pub fn get() -> Qol {
+    *NOW.read().unwrap_or_else(|e| e.into_inner())
+}
+
+/// Once a client tick: reads the file again every tenth call.
+pub fn refresh() {
+    if CALLS.fetch_add(1, Ordering::Relaxed) % 10 != 0 {
+        return;
+    }
+    let found = std::fs::read_to_string(FILE).map_or(OFF, |text| Qol::parse(&text));
+    *NOW.write().unwrap_or_else(|e| e.into_inner()) = found;
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn reads_the_switches_and_skips_the_rest() {
+        let q = Qol::parse("sprint=true\nxray = 1\nfly=true\nnonsense\n");
+        assert_eq!(q, Qol { sprint: true, xray: true });
+        assert_eq!(Qol::parse("sprint=false\n"), OFF);
+    }
+}
