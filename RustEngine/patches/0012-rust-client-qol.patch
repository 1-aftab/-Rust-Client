+        _ if name.ends_with("diamond_ore") => 6,
+        _ if name.ends_with("emerald_ore") => 7,
+        _ if name.ends_with("chest") => 11,
+        _ if name.ends_with("shulker_box") => 13,
+        _ if name.ends_with("spawner") => 14,
+        _ => return 0,
+    };
