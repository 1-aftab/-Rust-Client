diff --git a/crates/horizon-client/src/rc_qol.rs b/crates/horizon-client/src/rc_qol.rs
new file mode 100644
index 0000000..7d9b343
--- /dev/null
+++ b/crates/horizon-client/src/rc_qol.rs
@@ -0,0 +1,209 @@
+//! Rust Client: the quality-of-life switches. The launcher's "QOL" page writes them to
+//! `rust-client-qol.txt` in the game folder (`key=value` lines); the game reads the file
+//! again twice a second, so a switch acts at once. Everything is off without the file.
+use std::sync::RwLock;
+use std::sync::atomic::{AtomicU32, Ordering};
+
+/// The file, in the game folder (the working directory).
+pub const FILE: &str = "rust-client-qol.txt";
+
+/// X-Ray's block groups: the file's key, the group's bit in the mesher's mask
+/// (`mesher::xray_group` gives a block's), and whether it shows unless the file says no.
+pub const XRAY_GROUPS: [(&str, u32, bool); 19] = [
+    ("xray_coal", 0, true),
+    ("xray_iron", 1, true),
+    ("xray_copper", 2, true),
+    ("xray_gold", 3, true),
+    ("xray_redstone", 4, true),
+    ("xray_lapis", 5, true),
+    ("xray_diamond", 6, true),
+    ("xray_emerald", 7, true),
+    ("xray_quartz", 8, true),
+    ("xray_nether_gold", 9, true),
+    ("xray_debris", 10, true),
+    ("xray_chests", 11, true),
+    ("xray_barrels", 12, true),
+    ("xray_shulkers", 13, true),
+    ("xray_spawners", 14, true),
+    ("xray_lava", 15, true),
+    ("xray_water", 16, false),
+    ("xray_amethyst", 17, false),
+    ("xray_portal", 18, true),
+];
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Qol {
+    /// Always sprint while moving forward.
+    pub sprint: bool,
+    /// X-Ray: only the chosen block groups are drawn.
+    pub xray: bool,
+    /// The groups chosen, a bit each (`XRAY_GROUPS`).
+    pub xray_groups: u32,
+    /// What X-Ray shows is fully lit.
+    pub xray_bright: bool,
+    /// Trigger Bot: attack what the crosshair is on.
+    pub trigger: bool,
+    pub trigger_players: bool,
+    pub trigger_monsters: bool,
+    pub trigger_animals: bool,
+    /// Only with a sword, an axe, a trident or a mace in the hand.
+    pub trigger_weapon_only: bool,
+    /// Only once the attack has charged again.
+    pub trigger_cooldown: bool,
+    /// Only while falling (critical hits).
+    pub trigger_falling: bool,
+    /// Ticks the crosshair stays on the target first, and up to this many more at random.
+    pub trigger_delay: u32,
+    pub trigger_random: u32,
+}
+
+impl Qol {
+    /// What the mesher is told: 0 with X-Ray off, else bit 31, bit 30 for full light and the
+    /// groups.
+    pub fn xray_mask(&self) -> u32 {
+        if !self.xray {
+            return 0;
+        }
+        (1u32 << 31) | (u32::from(self.xray_bright) << 30) | self.xray_groups
+    }
+    pub fn off() -> Self {
+        let mut groups = 0;
+        for (_, bit, on) in XRAY_GROUPS {
+            groups |= u32::from(on) << bit;
+        }
+        Self {
+            sprint: false,
+            xray: false,
+            xray_groups: groups,
+            xray_bright: true,
+            trigger: false,
+            trigger_players: true,
+            trigger_monsters: true,
+            trigger_animals: false,
+            trigger_weapon_only: false,
+            trigger_cooldown: true,
+            trigger_falling: false,
+            trigger_delay: 1,
+            trigger_random: 0,
+        }
+    }
+    pub fn parse(text: &str) -> Self {
+        let mut q = Self::off();
+        for line in text.lines() {
+            let Some((key, value)) = line.split_once('=') else {
+                continue;
+            };
+            let (key, value) = (key.trim(), value.trim());
+            let on = value == "true" || value == "1";
+            let ticks = |max: u32| value.parse::<u32>().map_or(0, |v| v.min(max));
+            match key {
+                "sprint" => q.sprint = on,
+                "xray" => q.xray = on,
+                "xray_bright" => q.xray_bright = on,
+                "trigger" => q.trigger = on,
+                "trigger_players" => q.trigger_players = on,
+                "trigger_monsters" => q.trigger_monsters = on,
+                "trigger_animals" => q.trigger_animals = on,
+                "trigger_weapon_only" => q.trigger_weapon_only = on,
+                "trigger_cooldown" => q.trigger_cooldown = on,
+                "trigger_falling" => q.trigger_falling = on,
+                "trigger_delay" => q.trigger_delay = ticks(40),
+                "trigger_random" => q.trigger_random = ticks(40),
+                _ => {
+                    if let Some(&(_, bit, _)) = XRAY_GROUPS.iter().find(|g| g.0 == key) {
+                        q.xray_groups = (q.xray_groups & !(1u32 << bit)) | (u32::from(on) << bit);
+                    }
+                }
+            }
+        }
+        q
+    }
+}
+
+static NOW: RwLock<Option<Qol>> = RwLock::new(None);
+static CALLS: AtomicU32 = AtomicU32::new(0);
+/// The keys that switch X-Ray and Trigger Bot (`xray_key`, `trigger_key`: a vanilla key name
+/// like `key.keyboard.x`, or nothing for no key).
+static KEYS: RwLock<(String, String)> = RwLock::new((String::new(), String::new()));
+
+/// The value of `name` in the file's text.
+fn value_of<'a>(text: &'a str, name: &str) -> &'a str {
+    text.lines()
+        .filter_map(|l| l.split_once('='))
+        .find(|(k, _)| k.trim() == name)
+        .map_or("", |(_, v)| v.trim())
+}
+
+/// Takes the file's text as the switches of now.
+fn take(text: &str) {
+    *NOW.write().unwrap_or_else(|e| e.into_inner()) = Some(Qol::parse(text));
+    *KEYS.write().unwrap_or_else(|e| e.into_inner()) = (
+        value_of(text, "xray_key").to_owned(),
+        value_of(text, "trigger_key").to_owned(),
+    );
+}
+
+/// A key went down while playing: X-Ray's or Trigger Bot's key switches it, in the file too
+/// (the launcher's page shows the file). Whether it was one of them.
+pub fn key_pressed(key: &str) -> bool {
+    let name = {
+        let keys = KEYS.read().unwrap_or_else(|e| e.into_inner());
+        if !keys.0.is_empty() && keys.0 == key {
+            "xray"
+        } else if !keys.1.is_empty() && keys.1 == key {
+            "trigger"
+        } else {
+            return false;
+        }
+    };
+    let now = get();
+    let on = !(if name == "xray" { now.xray } else { now.trigger });
+    let old = std::fs::read_to_string(FILE).unwrap_or_default();
+    let mut text: String = old
+        .lines()
+        .filter(|l| l.split_once('=').is_none_or(|(k, _)| k.trim() != name))
+        .map(|l| format!("{l}\n"))
+        .collect();
+    text.push_str(&format!("{name}={on}\n"));
+    let _ = std::fs::write(FILE, &text);
+    take(&text);
+    true
+}
+static ATTACK_CLICKS: AtomicU32 = AtomicU32::new(0);
+
+/// The switches as they are now.
+pub fn get() -> Qol {
+    (*NOW.read().unwrap_or_else(|e| e.into_inner())).unwrap_or_else(Qol::off)
+}
+
+/// Once a client tick: reads the file again every tenth call.
+pub fn refresh() {
+    if CALLS.fetch_add(1, Ordering::Relaxed) % 10 != 0 {
+        return;
+    }
+    take(&std::fs::read_to_string(FILE).unwrap_or_default());
+}
+
+/// Trigger Bot's click: one attack for the next tick's input (`remote_handle_input`).
+pub fn click_attack() {
+    ATTACK_CLICKS.store(1, Ordering::Relaxed);
+}
+pub fn take_attack_clicks() -> u32 {
+    ATTACK_CLICKS.swap(0, Ordering::Relaxed)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn reads_the_switches_and_skips_the_rest() {
+        let q = Qol::parse("sprint=true\nxray = 1\nxray_coal=false\nxray_water=true\nfly=true\n");
+        assert!(q.sprint && q.xray && !q.trigger);
+        assert_eq!(q.xray_groups & 1, 0);
+        assert_ne!(q.xray_groups & (1 << 16), 0);
+        assert_ne!(q.xray_mask() & (1 << 31), 0);
+        assert_eq!(Qol::parse("sprint=false\n"), Qol::off());
+        assert_eq!(Qol::off().xray_mask(), 0);
+    }
+}
