@@ -0,0 +1,98 @@
+//! Rust Client: the quality-of-life switches at work in the game (`horizon_client::rc_qol`
+//! has the switches themselves). Sprint is with the keys in `game/remote.rs`; X-Ray is in
+//! the section mesher, and here every section is meshed again when it changes; Trigger Bot
+//! is here.
+use super::{Game, Screen};
+use horizon_client::{mesher, rc_qol};
+use std::cell::Cell;
+use std::sync::atomic::Ordering;
+
+thread_local! {
+    /// Ticks the crosshair has been on a target, and the ticks it has to be this time.
+    static ON_TARGET: Cell<(u32, u32)> = const { Cell::new((0, 0)) };
+    static RANDOM: Cell<u32> = const { Cell::new(0x2545_F491) };
+}
+
+/// A number below `n` (xorshift; nothing depends on its quality).
+fn random_below(n: u32) -> u32 {
+    RANDOM.with(|r| {
+        let mut x = r.get();
+        x ^= x << 13;
+        x ^= x >> 17;
+        x ^= x << 5;
+        r.set(x);
+        x % n.max(1)
+    })
+}
+
+impl Game<'_> {
+    /// Once a client tick.
+    pub(super) fn rc_qol_tick(&mut self) {
+        rc_qol::refresh();
+        let q = rc_qol::get();
+        let mask = q.xray_mask();
+        if mesher::XRAY.swap(mask, Ordering::Relaxed) != mask {
+            self.all_sections_changed();
+        }
+        if q.trigger {
+            self.rc_trigger(q);
+        }
+    }
+
+    /// Trigger Bot: with the crosshair on a mob of a chosen kind for the delay, one attack
+    /// click, made by the hands as the player's own.
+    fn rc_trigger(&mut self, q: rc_qol::Qol) {
+        let wait = |ticks: (u32, u32)| ON_TARGET.with(|w| w.set(ticks));
+        if self.screen != Screen::Playing {
+            return wait((0, 0));
+        }
+        let own = self.rc_own_id();
+        let target = self.mob_hit().is_some_and(|(i, distance)| {
+            let m = &self.mobs[i];
+            let chosen = if m.kind.id == "minecraft:player" {
+                q.trigger_players
+            } else if m.hostile() {
+                q.trigger_monsters
+            } else {
+                q.trigger_animals
+            };
+            chosen && m.alive() && Some(m.id as i32) != own && self.before_block(distance)
+        });
+        if !target {
+            return wait((0, 0));
+        }
+        if q.trigger_weapon_only {
+            let item = self.held().map_or(String::new(), |s| format!("{}", s.item));
+            let item = item.strip_prefix("minecraft:").unwrap_or(&item);
+            let weapon = item.ends_with("_sword")
+                || item.ends_with("_axe")
+                || item.ends_with("_spear")
+                || matches!(item, "trident" | "mace");
+            if !weapon {
+                return wait((0, 0));
+            }
+        }
+        let (mut waited, mut needed) = ON_TARGET.with(Cell::get);
+        if waited == 0 {
+            needed = q.trigger_delay + random_below(q.trigger_random + 1);
+        }
+        waited += 1;
+        wait((waited, needed));
+        if waited <= needed {
+            return;
+        }
+        if q.trigger_cooldown && !self.rc_attack_ready() {
+            return;
+        }
+        if q.trigger_falling
+            && !self
+                .player
+                .as_ref()
+                .is_some_and(|p| !p.ground.on_ground && p.velocity.y < 0.0)
+        {
+            return;
+        }
+        rc_qol::click_attack();
+        wait((0, 0));
+    }
+}
