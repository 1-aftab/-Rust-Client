+    // Rust Client: the host launcher draws its own on-screen controls in a window over the
+    // game's and plays the game through them (RustInputAdapter.kt). What they do comes here
+    // from the UI thread and goes on as a mouse's and a keyboard's events (game/input_mode.rs).
+
+    /// The host's controls are in use: the game keeps to the keyboard and mouse while a world
+    /// is played, so its own touch controls stay away.
+    static EXTERNAL_CONTROLS: AtomicBool = AtomicBool::new(false);
+    /// The keys the host's controls pressed and released since the game last asked.
+    static EXTERNAL_KEYS: Mutex<Vec<ExternalKey>> = Mutex::new(Vec::new());
+
+    /// A key of the host's controls: an Android key code (`KeyEvent.KEYCODE_*`), and the
+    /// character it types if any (with key code 0, a character an input method typed).
+    pub struct ExternalKey {
+        pub keycode: u32,
+        pub pressed: bool,
+        pub character: Option<char>,
+    }
+
+    pub fn set_external_controls(on: bool) {
+        EXTERNAL_CONTROLS.store(on, Ordering::Relaxed);
+    }
+
+    pub fn external_controls() -> bool {
+        EXTERNAL_CONTROLS.load(Ordering::Relaxed)
+    }
+
+    /// Whether the game reads the mouse yet: before, the host's events would be lost.
+    pub fn external_ready() -> bool {
+        MOUSE.lock().unwrap_or_else(|e| e.into_inner()).taken
+    }
+
+    /// A mouse event of the host's controls, for the game's next loop iteration.
+    pub fn push_external_mouse(event: MouseEvent) {
+        let mut mouse = MOUSE.lock().unwrap_or_else(|e| e.into_inner());
+        if mouse.taken && mouse.events.len() < MOUSE_QUEUE {
+            mouse.events.push(event);
+        }
+    }
+
+    /// A key of the host's controls, for the game's next loop iteration.
+    pub fn push_external_key(key: ExternalKey) {
+        let mut keys = EXTERNAL_KEYS.lock().unwrap_or_else(|e| e.into_inner());
+        if keys.len() < MOUSE_QUEUE {
+            keys.push(key);
+        }
+    }
+
+    /// The host's keys since the last call.
+    pub fn take_external_keys() -> Vec<ExternalKey> {
+        std::mem::take(&mut *EXTERNAL_KEYS.lock().unwrap_or_else(|e| e.into_inner()))
+    }
 }
 
