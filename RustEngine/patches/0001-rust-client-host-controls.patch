+    /// Rust Client: the keys the host launcher's on-screen controls pressed and released since
+    /// the last iteration, as the window events a keyboard's keys make.
+    #[cfg(target_os = "android")]
+    fn external_key_frame(&mut self, event_loop: &dyn EventLoopCtl) {
