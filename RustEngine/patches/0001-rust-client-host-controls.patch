+/// Rust Client: `StarlingActivity.nativeExternalControls`. The host launcher's on-screen controls
+/// are shown (or put away): the game leaves its own touch controls out while a world is played.
+#[unsafe(no_mangle)]
+extern "system" fn Java_io_github_juanluci_starling_StarlingActivity_nativeExternalControls(
+    _env: *mut std::ffi::c_void,
+    _class: *mut std::ffi::c_void,
+    on: u8,
+) {
+    horizon_client::android::set_external_controls(on != 0);
+}
+
+/// Rust Client: `StarlingActivity.nativeExternalReady`. Whether the game reads the host's events
+/// yet (it does from its first loop iteration; the start-up screens before it do not).
+#[unsafe(no_mangle)]
+extern "system" fn Java_io_github_juanluci_starling_StarlingActivity_nativeExternalReady(
+    _env: *mut std::ffi::c_void,
+    _class: *mut std::ffi::c_void,
+) -> u8 {
+    u8::from(horizon_client::android::external_ready())
+}
+
+/// Rust Client: `StarlingActivity.nativeExternalMouse`. `kind` 0 moves the pointer to (`x`, `y`)
+/// in window pixels, 1 moves the captured mouse by (`x`, `y`) pixels (the view turns), 2 turns
+/// the wheel by (`x`, `y`) lines.
+#[unsafe(no_mangle)]
+extern "system" fn Java_io_github_juanluci_starling_StarlingActivity_nativeExternalMouse(
+    _env: *mut std::ffi::c_void,
+    _class: *mut std::ffi::c_void,
+    kind: i32,
+    x: f32,
+    y: f32,
+) {
+    use horizon_client::android::MouseEvent;
+    let event = match kind {
+        0 => MouseEvent::Moved(f64::from(x), f64::from(y)),
+        1 => MouseEvent::Motion(f64::from(x), f64::from(y)),
+        2 => MouseEvent::Wheel(x, y),
+        _ => return,
+    };
+    horizon_client::android::push_external_mouse(event);
+}
+
+/// Rust Client: `StarlingActivity.nativeExternalButton`. `button` 0 is the left mouse button,
+/// 1 the right, 2 the middle (GLFW's numbers).
+#[unsafe(no_mangle)]
+extern "system" fn Java_io_github_juanluci_starling_StarlingActivity_nativeExternalButton(
+    _env: *mut std::ffi::c_void,
+    _class: *mut std::ffi::c_void,
+    button: i32,
+    pressed: u8,
+) {
+    let button = match button {
+        0 => winit::event::MouseButton::Left,
+        1 => winit::event::MouseButton::Right,
+        2 => winit::event::MouseButton::Middle,
+        _ => return,
+    };
+    horizon_client::android::push_external_mouse(horizon_client::android::MouseEvent::Button(
+        button,
+        pressed != 0,
+    ));
+}
+
+/// Rust Client: `StarlingActivity.nativeExternalKey`. `keycode` is Android's
+/// (`KeyEvent.KEYCODE_*`); `character` is the Unicode code point the key types, or 0.
+#[unsafe(no_mangle)]
+extern "system" fn Java_io_github_juanluci_starling_StarlingActivity_nativeExternalKey(
+    _env: *mut std::ffi::c_void,
+    _class: *mut std::ffi::c_void,
+    keycode: i32,
+    pressed: u8,
+    character: i32,
+) {
+    let Ok(keycode) = u32::try_from(keycode) else {
+        return;
+    };
+    let character = u32::try_from(character)
+        .ok()
+        .filter(|c| *c != 0)
+        .and_then(char::from_u32);
+    horizon_client::android::push_external_key(horizon_client::android::ExternalKey {
+        keycode,
+        pressed: pressed != 0,
+        character,
+    });
+}
