@@ -21,9 +21,20 @@ const FILES_DONE: &str = "starling-files.json";
 /// Whether the game signs in itself: on Android, or on a desktop asked to
 /// (`STARLING_ACCOUNTS=1`; the launcher signs in there otherwise).
 pub fn in_game() -> bool {
+    // Rust Client: the host launcher keeps the accounts and hands the game the player's name
+    // and skin (RustEdition.kt); the game shows no account screens of its own.
+    if host_accounts() {
+        return false;
+    }
     crate::platform::registered() || std::env::var_os("STARLING_ACCOUNTS").is_some_and(|v| v == "1")
 }
 
+/// Rust Client: whether the host launcher keeps the accounts (`RUST_CLIENT_HOST_ACCOUNTS=1`,
+/// which it writes to the game's arguments file).
+pub fn host_accounts() -> bool {
+    std::env::var_os("RUST_CLIENT_HOST_ACCOUNTS").is_some_and(|v| v == "1")
+}
+
 /// The private folder holding `accounts.json` and the sealed secrets.
 pub fn dir() -> PathBuf {
     crate::logging::private_home().join("accounts")
