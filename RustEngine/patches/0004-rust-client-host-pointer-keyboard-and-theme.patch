+    /// Rust Client: the host's pointer as a finger on the screens that read touches only. True
+    /// when one of them took the event, which then goes no further.
+    #[cfg(target_os = "android")]
+    fn external_finger(&mut self, event: &crate::android::MouseEvent) -> bool {
+        use crate::android::MouseEvent;
+        use std::sync::Mutex;
+        use winit::event::MouseButton;
+        /// Where the host's pointer is, and whether its button is held on one of those screens.
+        static POINTER: Mutex<((f64, f64), bool)> = Mutex::new(((0.0, 0.0), false));
+        let (phase, at) = {
+            let mut pointer = POINTER.lock().unwrap_or_else(|e| e.into_inner());
+            match *event {
+                MouseEvent::Moved(x, y) => {
+                    pointer.0 = (x, y);
+                    if !pointer.1 {
+                        return false;
+                    }
+                    (TouchPhase::Moved, pointer.0)
+                }
+                MouseEvent::Button(MouseButton::Left, true) => (TouchPhase::Started, pointer.0),
+                MouseEvent::Button(MouseButton::Left, false) if pointer.1 => {
+                    pointer.1 = false;
+                    (TouchPhase::Ended, pointer.0)
+                }
+                _ => return false,
+            }
+        };
+        let touch = winit::event::Touch {
+            device_id: DeviceId::dummy(),
+            phase,
+            location: PhysicalPosition::new(at.0, at.1),
+            force: None,
+            id: u64::MAX - 1,
+        };
+        let taken = self.files_offer_touch(&touch)
+            || self.update_offer_touch(&touch)
+            || self.native_builds_touch(&touch)
+            || self.catalog_touch(&touch);
+        if phase == TouchPhase::Started && taken {
+            POINTER.lock().unwrap_or_else(|e| e.into_inner()).1 = true;
+        }
+        // The lift of a press one of them took is theirs too, even if it closed the screen.
+        taken || phase == TouchPhase::Ended
+    }
