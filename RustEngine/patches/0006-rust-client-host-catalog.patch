+/// Rust Client: `EngineCatalog.nativeSearch`: one page of a shelf of the mod catalog, as JSON.
+#[unsafe(no_mangle)]
+extern "system" fn Java_io_github_juanluci_starling_EngineCatalog_nativeSearch(
+    mut env: jni::JNIEnv,
+    _class: jni::objects::JClass,
+    shelf: i32,
+    text: jni::objects::JString,
+    everything: u8,
+    offset: i32,
+) -> jni::sys::jstring {
+    let text = if text.is_null() {
+        String::new()
+    } else {
+        env.get_string(&text).map(String::from).unwrap_or_default()
+    };
+    let found = horizon_client::android::host_catalog::search(
+        shelf,
+        &text,
+        everything != 0,
+        offset.max(0) as usize,
+    );
+    env.new_string(found)
