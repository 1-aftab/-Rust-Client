diff --git a/third_party/winit/src/platform_impl/android/mod.rs b/third_party/winit/src/platform_impl/android/mod.rs
index 7813fb4..b7c920c 100644
--- a/third_party/winit/src/platform_impl/android/mod.rs
+++ b/third_party/winit/src/platform_impl/android/mod.rs
@@ -45,2 +45,26 @@ pub(crate) fn set_input_hook(hook: crate::platform::android::InputHook) {
 
+/// Rust Client's patch: the key event this backend makes of an Android key code, for a key that
+/// did not come through the activity's input queue (the host launcher's on-screen controls).
+pub(crate) fn external_key_event(
+    keycode: u32,
+    pressed: bool,
+    character: Option<char>,
+) -> event::KeyEvent {
+    let keycode = Keycode::from(keycode);
+    let state =
+        if pressed { event::ElementState::Pressed } else { event::ElementState::Released };
+    let key_char = character.map(android_activity::input::KeyMapChar::Unicode);
+    let logical_key = keycodes::to_logical(key_char, keycode);
+    let text = if pressed { logical_key.to_text().map(smol_str::SmolStr::new) } else { None };
+    event::KeyEvent {
+        state,
+        physical_key: keycodes::to_physical_key(keycode),
+        logical_key,
+        location: keycodes::to_location(keycode),
+        repeat: false,
+        text,
+        platform_specific: KeyEventExtra {},
+    }
+}
