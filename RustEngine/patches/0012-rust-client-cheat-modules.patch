diff --git a/crates/horizon-client/src/game/rc_cheats.rs b/crates/horizon-client/src/game/rc_cheats.rs
new file mode 100644
index 0000000..cc6d3ff
--- /dev/null
+++ b/crates/horizon-client/src/game/rc_cheats.rs
@@ -0,0 +1,340 @@
+//! Rust Client: the cheat modules that pick targets and draw (`horizon_client::rc_cheats`
+//! has the switches): Kill Aura, Trigger Bot, Anti AFK, ESP, tracers and the ore finder.
+use super::{Game, Screen};
+use horizon_client::{hud::HudBatch, mobs::Mob, rc_cheats as rc};
+use std::cell::{Cell, RefCell};
+use std::collections::HashMap;
+
+/// How far around the player the ore finder looks, in blocks each way.
+const SCAN_RADIUS: i32 = 20;
+/// The most marks it shows.
+const MARKS: usize = 300;
+
+#[derive(Default)]
+struct Scan {
+    centre: [i32; 3],
+    layer: i32,
+    found: Vec<([i32; 3], u32)>,
+    shown: Vec<([i32; 3], u32)>,
+    /// Block state to mark colour (0: not marked).
+    colours: HashMap<u32, u32>,
+}
+
+thread_local! {
+    static AGE: Cell<u32> = const { Cell::new(0) };
+    static TRIGGER_WAIT: Cell<u32> = const { Cell::new(0) };
+    static SCAN: RefCell<Scan> = RefCell::new(Scan::default());
+}
+
+/// The colour a block is marked with, 0 for a block that isn't.
+fn mark_colour(name: &str) -> u32 {
+    let name = name.strip_prefix("minecraft:").unwrap_or(name);
+    if name.ends_with("_ore") {
+        if name.contains("diamond") {
+            0x5DECF5
+        } else if name.contains("emerald") {
+            0x17DD62
+        } else if name.contains("gold") {
+            0xFCEE4B
+        } else if name.contains("iron") {
+            0xD8AF93
+        } else if name.contains("redstone") {
+            0xFF2020
+        } else if name.contains("lapis") {
+            0x4070E0
+        } else if name.contains("copper") {
+            0xE77C56
+        } else if name.contains("quartz") {
+            0xE3DBD1
+        } else {
+            0x707070
+        }
+    } else if name == "ancient_debris" {
+        0xB06040
+    } else if name.ends_with("chest") || name == "barrel" || name.ends_with("shulker_box") {
+        0xFFA500
+    } else if name.ends_with("spawner") || name == "vault" {
+        0xC040FF
+    } else {
+        0
+    }
+}
+
+fn wanted(m: &Mob, players: bool, hostile: bool, passive: bool) -> bool {
+    if m.kind.id == "minecraft:player" {
+        players
+    } else if m.hostile() {
+        hostile
+    } else {
+        passive
+    }
+}
+
+impl Game<'_> {
+    /// Once a client tick, on any server (single player's own included).
+    pub(super) fn rc_cheats_tick(&mut self) {
+        rc::refresh();
+        let c = rc::get();
+        if !c.ticks() || self.screen != Screen::Playing || self.player.is_none() {
+            return;
+        }
+        let age = AGE.with(|a| {
+            let age = a.get().wrapping_add(1);
+            a.set(age);
+            age
+        });
+        if c.antiafk && age % 600 == 0 {
+            self.yaw += if age % 1200 == 0 { 25.0 } else { -25.0 };
+            rc::press_jump();
+        }
+        if c.xray {
+            self.rc_scan();
+        }
+        if !(c.killaura || c.triggerbot) {
+            return;
+        }
+        let own = self.rc_own_id();
+        let skip = |game: &Self, m: &Mob| {
+            m.removed
+                || !m.alive()
+                || Some(m.id as i32) == own
+                || Some(m.id) == game.riding
+                || !wanted(m, c.target_players, c.target_hostile, c.target_passive)
+        };
+        if c.killaura {
+            let Some(eye) = self.eye_position() else {
+                return;
+            };
+            let range = f64::from(c.aura_range);
+            let mut best: Option<(usize, f64, [f64; 3])> = None;
+            for (i, m) in self.mobs.iter().enumerate() {
+                if skip(self, m) {
+                    continue;
+                }
+                let b = m.bounds();
+                let (lo, hi) = (b.min_position(), b.max_position());
+                let near = [
+                    eye[0].clamp(lo.x, hi.x),
+                    eye[1].clamp(lo.y, hi.y),
+                    eye[2].clamp(lo.z, hi.z),
+                ];
+                let d2: f64 = (0..3).map(|a| (eye[a] - near[a]).powi(2)).sum();
+                if d2 <= range * range && best.is_none_or(|b| d2 < b.1) {
+                    let centre = [
+                        (lo.x + hi.x) / 2.0,
+                        (lo.y + hi.y) / 2.0,
+                        (lo.z + hi.z) / 2.0,
+                    ];
+                    best = Some((i, d2, centre));
+                }
+            }
+            if let Some((i, _, centre)) = best {
+                // The camera follows the target; the hit waits for the cooldown.
+                let (dx, dy, dz) = (centre[0] - eye[0], centre[1] - eye[1], centre[2] - eye[2]);
+                let flat = (dx * dx + dz * dz).sqrt();
+                let yaw = (-dx).atan2(dz).to_degrees() as f32;
+                let pitch = (-dy.atan2(flat)).to_degrees() as f32;
+                let mut turn = (yaw - self.yaw).rem_euclid(360.0);
+                if turn > 180.0 {
+                    turn -= 360.0;
+                }
+                self.yaw += turn;
+                self.pitch = pitch.clamp(-90.0, 90.0);
+                if self.rc_attack_ready() {
+                    self.rc_attack_mob(i);
+                }
+            }
+            return;
+        }
+        // Trigger Bot: the crosshair's own target, clicked as the player would.
+        let on_target = self
+            .mob_hit()
+            .is_some_and(|(i, d)| self.before_block(d) && !skip(self, &self.mobs[i]));
+        if !on_target {
+            TRIGGER_WAIT.with(|w| w.set(0));
+            return;
+        }
+        let waited = TRIGGER_WAIT.with(|w| {
+            let waited = w.get();
+            w.set(waited.saturating_add(1));
+            waited
+        });
+        if waited >= c.trigger_delay && self.rc_attack_ready() {
+            rc::click_attack();
+            TRIGGER_WAIT.with(|w| w.set(0));
+        }
+    }
+
+    /// The ore finder: one layer of the blocks around the player a tick, a pass a
+    /// couple of seconds, then the pass's marks replace the ones shown.
+    fn rc_scan(&self) {
+        let Some(p) = self.player.as_ref() else {
+            return;
+        };
+        let feet = [
+            p.position.x.floor() as i32,
+            p.position.y.floor() as i32,
+            p.position.z.floor() as i32,
+        ];
+        SCAN.with(|scan| {
+            let mut scan = scan.borrow_mut();
+            let scan = &mut *scan;
+            if scan.layer > SCAN_RADIUS {
+                let mut found = std::mem::take(&mut scan.found);
+                let centre = scan.centre;
+                found.sort_by_key(|(at, _)| {
+                    (0..3).map(|a| i64::from(at[a] - centre[a]).pow(2)).sum::<i64>()
+                });
+                found.truncate(MARKS);
+                scan.shown = found;
+                scan.layer = -SCAN_RADIUS;
+                scan.centre = feet;
+                scan.colours.clear();
+            }
+            let y = scan.centre[1] + scan.layer;
+            scan.layer += 1;
+            if !(-64..320).contains(&y) {
+                return;
+            }
+            for dz in -SCAN_RADIUS..=SCAN_RADIUS {
+                for dx in -SCAN_RADIUS..=SCAN_RADIUS {
+                    let (x, z) = (scan.centre[0] + dx, scan.centre[2] + dz);
+                    let state = self.world.block(x, y, z);
+                    let known = scan.colours.get(&state.0).copied();
+                    let colour = match known {
+                        Some(colour) => colour,
+                        None => {
+                            let colour = mark_colour(&self.res.facts().get(state).name);
+                            scan.colours.insert(state.0, colour);
+                            colour
+                        }
+                    };
+                    if colour != 0 && scan.found.len() < MARKS * 8 {
+                        scan.found.push(([x, y, z], colour));
+                    }
+                }
+            }
+        });
+    }
+
+    /// The overlay, in the HUD layer, so it shows through walls: a frame around each
+    /// player and mob (ESP), a dotted line to it (tracers), a frame on each found block.
+    pub(super) fn rc_cheats_hud(&self, batch: &mut HudBatch) {
+        let c = rc::get();
+        if !c.draws() || self.screen != Screen::Playing {
+            return;
+        }
+        let Some(camera) = self.native_camera_frame.as_ref() else {
+            return;
+        };
+        let matrix = glam::Mat4::from_cols_array(&camera.projection)
+            * glam::Mat4::from_cols_array(&camera.view);
+        let origin = camera.position;
+        let (width, height) = (batch.width, batch.height);
+        let project = |p: [f64; 3]| -> Option<[f32; 2]> {
+            let clip = matrix
+                * glam::Vec4::new(
+                    (p[0] - origin[0]) as f32,
+                    (p[1] - origin[1]) as f32,
+                    (p[2] - origin[2]) as f32,
+                    1.0,
+                );
+            (clip.w > 0.05).then(|| {
+                [
+                    (clip.x / clip.w * 0.5 + 0.5) * width,
+                    (0.5 - clip.y / clip.w * 0.5) * height,
+                ]
+            })
+        };
+        // The frame on screen around the box `lo`..`hi`, when all of it is in front.
+        let frame = |lo: [f64; 3], hi: [f64; 3]| -> Option<[f32; 4]> {
+            let mut rect = [f32::INFINITY, f32::INFINITY, f32::NEG_INFINITY, f32::NEG_INFINITY];
+            for corner in 0..8 {
+                let at = project([
+                    if corner & 1 == 0 { lo[0] } else { hi[0] },
+                    if corner & 2 == 0 { lo[1] } else { hi[1] },
+                    if corner & 4 == 0 { lo[2] } else { hi[2] },
+                ])?;
+                rect = [
+                    rect[0].min(at[0]),
+                    rect[1].min(at[1]),
+                    rect[2].max(at[0]),
+                    rect[3].max(at[1]),
+                ];
+            }
+            let on_screen = rect[2] > 0.0 && rect[0] < width && rect[3] > 0.0 && rect[1] < height;
+            (on_screen && rect[2] - rect[0] < width * 2.0).then_some(rect)
+        };
+        let outline = |batch: &mut HudBatch, r: [f32; 4], argb: u32| {
+            let (w, h) = ((r[2] - r[0]).max(1.0), (r[3] - r[1]).max(1.0));
+            self.native_fill(batch, [r[0], r[1], w, 1.0], argb);
+            self.native_fill(batch, [r[0], r[3], w + 1.0, 1.0], argb);
+            self.native_fill(batch, [r[0], r[1], 1.0, h], argb);
+            self.native_fill(batch, [r[2], r[1], 1.0, h], argb);
+        };
+        if c.xray {
+            SCAN.with(|scan| {
+                for (at, colour) in &scan.borrow().shown {
+                    let lo = [f64::from(at[0]), f64::from(at[1]), f64::from(at[2])];
+                    if let Some(r) = frame(lo, [lo[0] + 1.0, lo[1] + 1.0, lo[2] + 1.0]) {
+                        outline(batch, r, 0xFF00_0000 | colour);
+                    }
+                }
+            });
+        }
+        if !(c.esp || c.tracers) {
+            return;
+        }
+        let own = self.rc_own_id();
+        let rest = f64::from(1.0 - camera.partial_tick.clamp(0.0, 1.0));
+        for m in &self.mobs {
+            if m.removed
+                || !m.alive()
+                || Some(m.id as i32) == own
+                || !wanted(m, c.show_players, c.show_hostile, c.show_passive)
+            {
+                continue;
+            }
+            let colour: u32 = if m.kind.id == "minecraft:player" {
+                0xFFFF_4040
+            } else if m.hostile() {
+                0xFFFF_A020
+            } else {
+                0xFF40_E060
+            };
+            // Between the last tick's place and this one's, as the mob is drawn.
+            let back = [
+                (m.previous.x - m.position.x) * rest,
+                (m.previous.y - m.position.y) * rest,
+                (m.previous.z - m.position.z) * rest,
+            ];
+            let b = m.bounds();
+            let (lo, hi) = (b.min_position(), b.max_position());
+            let lo = [lo.x + back[0], lo.y + back[1], lo.z + back[2]];
+            let hi = [hi.x + back[0], hi.y + back[1], hi.z + back[2]];
+            if c.esp
+                && let Some(r) = frame(lo, hi)
+            {
+                outline(batch, r, colour);
+            }
+            if c.tracers
+                && let Some(to) = project([
+                    (lo[0] + hi[0]) / 2.0,
+                    (lo[1] + hi[1]) / 2.0,
+                    (lo[2] + hi[2]) / 2.0,
+                ])
+            {
+                let from = [width / 2.0, height / 2.0];
+                let (dx, dy) = (to[0] - from[0], to[1] - from[1]);
+                let dots = ((dx.hypot(dy) / 3.0) as usize).clamp(2, 120);
+                for dot in 1..dots {
+                    let t = dot as f32 / dots as f32;
+                    let (x, y) = (from[0] + dx * t, from[1] + dy * t);
+                    if x >= 0.0 && x < width && y >= 0.0 && y < height {
+                        self.native_fill(batch, [x, y, 1.0, 1.0], colour);
+                    }
+                }
+            }
+        }
+    }
+}
