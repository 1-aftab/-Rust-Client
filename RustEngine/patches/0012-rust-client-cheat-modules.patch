diff --git a/crates/horizon-client/src/rc_cheats.rs b/crates/horizon-client/src/rc_cheats.rs
new file mode 100644
index 0000000..72b1413
--- /dev/null
+++ b/crates/horizon-client/src/rc_cheats.rs
@@ -0,0 +1,198 @@
+//! Rust Client: the cheat modules' switches. The launcher's "Cheats" menu writes them to
+//! `rust-client-cheats.txt` in the game folder (`key=value` lines); the game reads the file
+//! again twice a second, so a switch acts at once. Everything is off without the file.
+//!
+//! The modules themselves are where the game does the thing they change: the player's
+//! movement (`motion.rs`), what the client tells a server (`game/remote.rs`), the clicks
+//! (`first_person.rs`) and `game/rc_cheats.rs` (targets, the overlay).
+use std::sync::RwLock;
+use std::sync::atomic::{AtomicBool, AtomicU32, Ordering};
+
+/// The file, in the game folder (the working directory).
+pub const FILE: &str = "rust-client-cheats.txt";
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Cheats {
+    /// Always sprint while moving forward.
+    pub sprint: bool,
+    /// Creative flight in any game mode; `fly_speed` times its speed.
+    pub fly: bool,
+    pub fly_speed: f32,
+    /// Walk and steer in the air `speed_factor` times as fast.
+    pub speed: bool,
+    pub speed_factor: f32,
+    /// Tell the server the player is on the ground while it falls.
+    pub nofall: bool,
+    /// Walk up `step_height` blocks.
+    pub step: bool,
+    pub step_height: f32,
+    /// Climb a wall walked into.
+    pub spider: bool,
+    /// Rise to the surface of water and stay on it.
+    pub jesus: bool,
+    /// Take `velocity_percent` of a server's knockback.
+    pub velocity: bool,
+    pub velocity_percent: f32,
+    /// `reach_extra` more blocks of reach, for entities and blocks.
+    pub reach: bool,
+    pub reach_extra: f32,
+    /// Attack what the crosshair is on, after `trigger_delay` ticks.
+    pub triggerbot: bool,
+    pub trigger_delay: u32,
+    /// Turn to and attack the nearest target within `aura_range` blocks.
+    pub killaura: bool,
+    pub aura_range: f32,
+    /// What the two above attack.
+    pub target_players: bool,
+    pub target_hostile: bool,
+    pub target_passive: bool,
+    /// Every hit from the ground is told as a hit while falling.
+    pub criticals: bool,
+    /// Keep mining the block the crosshair is on.
+    pub automine: bool,
+    /// A turn and a jump every half minute.
+    pub antiafk: bool,
+    /// Boxes around players and mobs, seen through walls.
+    pub esp: bool,
+    /// Lines from the crosshair to them.
+    pub tracers: bool,
+    pub show_players: bool,
+    pub show_hostile: bool,
+    pub show_passive: bool,
+    /// Ores and containers nearby marked through walls.
+    pub xray: bool,
+}
+
+pub const OFF: Cheats = Cheats {
+    sprint: false,
+    fly: false,
+    fly_speed: 1.0,
+    speed: false,
+    speed_factor: 1.5,
+    nofall: false,
+    step: false,
+    step_height: 1.5,
+    spider: false,
+    jesus: false,
+    velocity: false,
+    velocity_percent: 0.0,
+    reach: false,
+    reach_extra: 1.5,
+    triggerbot: false,
+    trigger_delay: 1,
+    killaura: false,
+    aura_range: 3.5,
+    target_players: true,
+    target_hostile: true,
+    target_passive: false,
+    criticals: false,
+    automine: false,
+    antiafk: false,
+    esp: false,
+    tracers: false,
+    show_players: true,
+    show_hostile: true,
+    show_passive: false,
+    xray: false,
+};
+
+impl Cheats {
+    /// Whether anything is on that the game's tick has work for.
+    pub fn ticks(&self) -> bool {
+        self.triggerbot || self.killaura || self.antiafk || self.xray
+    }
+    /// Whether anything is on that the overlay draws.
+    pub fn draws(&self) -> bool {
+        self.esp || self.tracers || self.xray
+    }
+    pub fn parse(text: &str) -> Self {
+        let mut c = OFF;
+        for line in text.lines() {
+            let Some((key, value)) = line.split_once('=') else {
+                continue;
+            };
+            let value = value.trim();
+            let on = value == "true" || value == "1";
+            let number = |default: f32, min: f32, max: f32| {
+                value
+                    .parse::<f32>()
+                    .ok()
+                    .filter(|v| v.is_finite())
+                    .map_or(default, |v| v.clamp(min, max))
+            };
+            match key.trim() {
+                "sprint" => c.sprint = on,
+                "fly" => c.fly = on,
+                "fly_speed" => c.fly_speed = number(1.0, 0.2, 10.0),
+                "speed" => c.speed = on,
+                "speed_factor" => c.speed_factor = number(1.5, 1.0, 5.0),
+                "nofall" => c.nofall = on,
+                "step" => c.step = on,
+                "step_height" => c.step_height = number(1.5, 0.6, 10.0),
+                "spider" => c.spider = on,
+                "jesus" => c.jesus = on,
+                "velocity" => c.velocity = on,
+                "velocity_percent" => c.velocity_percent = number(0.0, 0.0, 100.0),
+                "reach" => c.reach = on,
+                "reach_extra" => c.reach_extra = number(1.5, 0.0, 3.0),
+                "triggerbot" => c.triggerbot = on,
+                "trigger_delay" => c.trigger_delay = number(1.0, 0.0, 20.0) as u32,
+                "killaura" => c.killaura = on,
+                "aura_range" => c.aura_range = number(3.5, 1.0, 6.0),
+                "target_players" => c.target_players = on,
+                "target_hostile" => c.target_hostile = on,
+                "target_passive" => c.target_passive = on,
+                "criticals" => c.criticals = on,
+                "automine" => c.automine = on,
+                "antiafk" => c.antiafk = on,
+                "esp" => c.esp = on,
+                "tracers" => c.tracers = on,
+                "show_players" => c.show_players = on,
+                "show_hostile" => c.show_hostile = on,
+                "show_passive" => c.show_passive = on,
+                "xray" => c.xray = on,
+                _ => {}
+            }
+        }
+        c
+    }
+}
+
+static NOW: RwLock<Cheats> = RwLock::new(OFF);
+static CALLS: AtomicU32 = AtomicU32::new(0);
+static ATTACK_CLICKS: AtomicU32 = AtomicU32::new(0);
+static JUMP: AtomicBool = AtomicBool::new(false);
+static FLEW: AtomicBool = AtomicBool::new(false);
+
+/// The switches as they are now.
+pub fn get() -> Cheats {
+    *NOW.read().unwrap_or_else(|e| e.into_inner())
+}
+
+/// Once a client tick: reads the file again every tenth call.
+pub fn refresh() {
+    if CALLS.fetch_add(1, Ordering::Relaxed) % 10 != 0 {
+        return;
+    }
+    let found = std::fs::read_to_string(FILE).map_or(OFF, |text| Cheats::parse(&text));
+    *NOW.write().unwrap_or_else(|e| e.into_inner()) = found;
+}
+
+/// The trigger bot's click: one attack click more for the hands' next tick.
+pub fn click_attack() {
+    ATTACK_CLICKS.store(1, Ordering::Relaxed);
+}
+pub fn take_attack_clicks() -> u32 {
+    ATTACK_CLICKS.swap(0, Ordering::Relaxed)
+}
+/// Tells whether Fly is on now, and answers whether it was on the tick before.
+pub fn fly_was(now: bool) -> bool {
+    FLEW.swap(now, Ordering::Relaxed)
+}
+/// Anti AFK's jump: the jump key for the player's next tick.
+pub fn press_jump() {
+    JUMP.store(true, Ordering::Relaxed);
+}
+pub fn take_jump() -> bool {
+    JUMP.swap(false, Ordering::Relaxed)
+}
