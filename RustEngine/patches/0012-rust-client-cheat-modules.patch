+/// Rust Client: the game files fetched and prepared without the game, for the host launcher's
+/// own set-up screen (RustSetupActivity.kt, through EngineSetup.java). The same download
+/// (accounts.rs) and the same preparer (preparer.rs) the game's set-up screen runs, in a process
+/// that has no activity of the engine's: what the platform hooks would ask the activity for
+/// comes from the host instead.
+/// Rust Client: the mod catalog as the host launcher's own screen. The game asks the host to
+/// show it ([`open`]); the host's screen searches, installs and removes through the functions
+/// here (`EngineCatalog.java`), on its own threads; the game hears of what changed
+/// ([`take_changes`]) and tidies the pages that list it.
+pub mod host_catalog {
+    use starling_catalog::{
+        Done, Shelf,
+        browser::{Project, installed::Entry},
+    };
+    use std::path::PathBuf;
+    use std::sync::{Mutex, MutexGuard};
+
+    /// What the host's screen did to the game folder.
+    pub enum Change {
+        Installed(Done),
+        Removed(Entry),
+    }
+
+    struct State {
+        home: Option<PathBuf>,
+        /// The projects the searches found; the host names one by its place here.
+        rows: Vec<Project>,
+        changes: Vec<Change>,
+        line: String,
+        fraction: f32,
+    }
+
+    static STATE: Mutex<State> = Mutex::new(State {
+        home: None,
+        rows: Vec::new(),
+        changes: Vec::new(),
+        line: String::new(),
+        fraction: 0.0,
+    });
+
+    fn state() -> MutexGuard<'static, State> {
+        STATE.lock().unwrap_or_else(|e| e.into_inner())
+    }
+
+    fn failed(why: &str) -> String {
+        serde_json::json!({ "error": why }).to_string()
+    }
+
+    /// Asks the host to show its catalog on `shelf`, for the game folder `home`. False when
+    /// the host has none: the game then shows its own.
+    pub fn open(home: PathBuf, shelf: Shelf) -> bool {
+        starling_catalog::set_game_home(home.clone());
+        state().home = Some(home);
+        let shelf = match shelf {
+            Shelf::Mods => 0,
+            Shelf::ResourcePacks => 1,
+            Shelf::ShaderPacks => 2,
+        };
+        super::with_activity(|env, activity| {
+            env.call_method(
+                activity,
+                "openCatalog",
+                "(I)Z",
+                &[jni::objects::JValue::Int(shelf)],
+            )?
+            .z()
+        })
+        .unwrap_or(false)
+    }
+
+    /// One page of a shelf as JSON: `rows` (each with its `handle`) and `more`, or `error`.
+    pub fn search(shelf: i32, text: &str, everything: bool, offset: usize) -> String {
+        let shelf = match shelf {
+            1 => Shelf::ResourcePacks,
+            2 => Shelf::ShaderPacks,
+            _ => Shelf::Mods,
+        };
+        let page = starling_catalog::list::PAGE;
+        let found = match starling_catalog::search(shelf, text, everything, offset, page) {
+            Ok(found) => found,
+            Err(e) => return failed(&e),
+        };
+        let home = state().home.clone();
+        let installed = home
+            .as_deref()
+            .map(starling_catalog::installed_projects)
+            .unwrap_or_default();
+        let more = found.len() >= page;
+        let mut state = state();
+        if offset == 0 && state.rows.len() > 4096 {
+            state.rows.clear();
+        }
+        let rows: Vec<serde_json::Value> = found
+            .into_iter()
+            .map(|project| {
+                let row = serde_json::json!({
+                    "handle": state.rows.len(),
+                    "id": project.id,
+                    "title": project.title,
+                    "summary": project.summary,
+                    "author": project.author,
+                    "downloads": project.downloads,
+                    "icon": project.icon,
+                    "page": project.page,
+                    "source": match project.source {
+                        starling_catalog::browser::SourceId::Modrinth => "modrinth",
+                        starling_catalog::browser::SourceId::CurseForge => "curseforge",
+                        starling_catalog::browser::SourceId::Horizon => "registry",
+                    },
+                    "installed": installed.contains(&project.id),
+                    "native": starling_catalog::is_native_mod(&project),
+                    "caution": starling_catalog::caution(&project),
+                });
+                state.rows.push(project);
+                row
+            })
+            .collect();
+        serde_json::json!({ "rows": rows, "more": more }).to_string()
+    }
+
+    /// The ids of the projects installed now, as a JSON list.
+    pub fn installed() -> String {
+        let home = state().home.clone();
+        let ids: Vec<String> = home
+            .as_deref()
+            .map(starling_catalog::installed_projects)
+            .unwrap_or_default()
+            .into_iter()
+            .collect();
+        serde_json::json!(ids).to_string()
+    }
+
+    /// Installs the project a search named `handle`; returns when it is done. JSON: `done`
+    /// (what kind of thing went in) or `error`.
+    pub fn install(handle: usize, everything: bool) -> String {
+        let (project, home) = {
+            let mut state = state();
+            state.line.clear();
+            state.fraction = 0.0;
+            (state.rows.get(handle).cloned(), state.home.clone())
+        };
+        let (Some(project), Some(home)) = (project, home) else {
+            return failed("That project is no longer listed: search again.");
+        };
+        let progress = |line: &str, fraction: f32| {
+            let mut state = state();
+            line.clone_into(&mut state.line);
+            state.fraction = fraction;
+        };
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            starling_catalog::install(&project, everything, &home, &progress)
+        }))
+        .unwrap_or_else(|_| Err(format!("Installing {} stopped.", project.title)));
+        match result {
+            Ok(done) => {
+                let kind = match done {
+                    Done::NativeMod => "native-mod",
+                    Done::ContentMod => "content-mod",
+                    Done::ResourcePack => "resource-pack",
+                    Done::ShaderPack => "shader-pack",
+                };
+                state().changes.push(Change::Installed(done));
+                serde_json::json!({ "done": kind }).to_string()
+            }
+            Err(e) => failed(&e),
+        }
+    }
+
+    /// How far the install is: the fraction done, a tab, and its line.
+    pub fn progress() -> String {
+        let state = state();
+        format!("{}\t{}", state.fraction, state.line)
+    }
+
+    /// Removes what was installed for the project a search named `handle`. JSON: empty, or
+    /// `error`.
+    pub fn remove(handle: usize) -> String {
+        let (project, home) = {
+            let state = state();
+            (state.rows.get(handle).cloned(), state.home.clone())
+        };
+        let (Some(project), Some(home)) = (project, home) else {
+            return failed("That project is no longer listed: search again.");
+        };
+        match starling_catalog::remove(&home, &project) {
+            Ok(entry) => {
+                state().changes.push(Change::Removed(entry));
+                "{}".to_owned()
+            }
+            Err(e) => failed(&e),
+        }
+    }
+
+    /// What the host's screen changed since the game last asked.
+    pub fn take_changes() -> Vec<Change> {
+        std::mem::take(&mut state().changes)
+    }
+}
