+/// Rust Client: the Step and Speed modules, for the window's own player only (a server's
+/// copy of a player moves as vanilla does).
+impl MotionWorld<'_, '_, '_> {
+    fn rc_step(&self, step: f32) -> f32 {
+        let rc = crate::rc_cheats::get();
+        if self.player.client_side && rc.step {
+            step.max(rc.step_height)
+        } else {
+            step
+        }
+    }
+    fn rc_speed(&self) -> f32 {
+        let rc = crate::rc_cheats::get();
+        if self.player.client_side && rc.speed {
