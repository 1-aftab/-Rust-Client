+    /// Rust Client, Criticals: a hit from the ground is told as one while falling (a hop
+    /// of a sixteenth of a block and back, off the ground, before the attack).
+    fn rc_criticals(&mut self) {
+        if !horizon_client::rc_cheats::get().criticals {
+            return;
+        }
+        let Some(p) = self.player.as_ref() else {
+            return;
+        };
+        if !p.ground.on_ground || p.flying || p.fluids.was_touching_water || self.riding.is_some() {
+            return;
+        }
+        let (x, y, z) = (p.position.x, p.position.y, p.position.z);
+        for up in [0.0625, 0.0] {
+            self.send(S::MovePlayerPos(play::MovePlayerPos {
+                x,
+                y: y + up,
+                z,
+                flags: 0,
+            }));
+        }
+    }
+    /// Rust Client: whether the attack has charged (the cooldown is over).
+    pub(super) fn rc_attack_ready(&mut self) -> bool {
+        let speed = self
+            .own_attribute("minecraft:attack_speed")
+            .unwrap_or_else(|| self.main_hand_attack_speed());
+        self.hand_strength.scale(0.5, speed) >= 0.95
+    }
+    /// Rust Client, Kill Aura: the attack `remote_start_attack` makes on the mob under the
+    /// crosshair, on `self.mobs[i]`.
+    pub(super) fn rc_attack_mob(&mut self, i: usize) {
+        if i >= self.mobs.len() {
+            return;
+        }
+        self.rc_criticals();
+        self.send(S::Attack(play::Attack {
+            id: self.mobs[i].id as i32,
+        }));
+        self.remote_player_attack(i);
+        self.reset_attack_strength();
+        self.swing_arm();
+        self.send(S::Punch(Empty));
+    }
+    /// Rust Client: this client's own entity on the server.
+    pub(super) fn rc_own_id(&self) -> Option<i32> {
+        self.remote.as_ref().map(|r| r.entity_id)
+    }
