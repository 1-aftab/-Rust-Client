+/// Rust Client: `EngineSetup.nativeInit`. The host launcher's set-up screen prepares the game
+/// files without the game (android.rs, `host_setup`): the engine's private folder, the folder of
+/// the app's libraries, and the folder the host copied the APK's assets to.
+#[unsafe(no_mangle)]
+extern "system" fn Java_io_github_juanluci_starling_EngineSetup_nativeInit(
+    mut env: jni::JNIEnv,
+    _class: jni::objects::JClass,
+    private: jni::objects::JString,
+    library: jni::objects::JString,
+    assets: jni::objects::JString,
+) {
+    let Ok(private) = env.get_string(&private).map(String::from) else {
+        return;
+    };
+    let Ok(library) = env.get_string(&library).map(String::from) else {
+        return;
+    };
+    let Ok(assets) = env.get_string(&assets).map(String::from) else {
+        return;
+    };
+    horizon_client::android::host_setup::init(private.into(), library.into(), assets.into());
+}
+
+/// Rust Client: `EngineSetup.nativeStart`.
+#[unsafe(no_mangle)]
+extern "system" fn Java_io_github_juanluci_starling_EngineSetup_nativeStart(
+    _env: *mut std::ffi::c_void,
+    _class: *mut std::ffi::c_void,
+) {
+    horizon_client::android::host_setup::start();
+}
+
+/// Rust Client: `EngineSetup.nativeCancel`.
+#[unsafe(no_mangle)]
+extern "system" fn Java_io_github_juanluci_starling_EngineSetup_nativeCancel(
+    _env: *mut std::ffi::c_void,
+    _class: *mut std::ffi::c_void,
+) {
+    horizon_client::android::host_setup::cancel();
+}
+
+/// Rust Client: `EngineSetup.nativeStatus`.
+#[unsafe(no_mangle)]
+extern "system" fn Java_io_github_juanluci_starling_EngineSetup_nativeStatus(
+    env: jni::JNIEnv,
+    _class: jni::objects::JClass,
+) -> jni::sys::jstring {
+    env.new_string(horizon_client::android::host_setup::status())
+        .map_or(std::ptr::null_mut(), |text| text.into_raw())
+}
